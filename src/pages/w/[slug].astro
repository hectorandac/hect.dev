---
import { getImage } from 'astro:assets';
import { writing } from '../../data/profile';

export function getStaticPaths() {
  return writing
    .filter((w) => w.url.includes('gait.aicu.life'))
    .map((w) => ({ params: { slug: w.url.split('/').pop() }, props: { w } }));
}

const { w } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/writing/*.{png,jpg,jpeg}', { eager: true });
const og = await getImage({ src: assets[`../../assets/${w.image}`].default, width: 1200, format: 'jpg' });
const image = new URL(og.src, Astro.site).href;
const self = new URL(`/w/${Astro.params.slug}`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{w.title}</title>
  <meta name="description" content={w.text} />
  <link rel="canonical" href={self} />
  <meta name="robots" content="noindex, follow" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={w.title} />
  <meta property="og:description" content={w.text} />
  <meta property="og:url" content={self} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Step Doctor by AICU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={w.title} />
  <meta name="twitter:description" content={w.text} />
  <meta name="twitter:image" content={image} />
  <meta name="author" content="Hector Andres Acosta Pozo" />
  <style>body{font:16px/1.5 system-ui,sans-serif;margin:15vh auto;max-width:560px;padding:0 16px;color:#222;background:#fff}a{color:#2563eb}</style>
</head>
<body>
  <p>Opening <a href={w.url}>{w.title}</a> on gait.aicu.life…</p>
  <script is:inline define:vars={{ to: w.url }}>location.replace(to);</script>
</body>
</html>
