---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { person, experience, research, projects, skills, education } from '../data/profile';
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base title={`Resume · ${person.name}`} description={`Resume of ${person.name}, ${person.role}, ${person.location}.`}>
  <div class="screen-only"><Header /></div>
  <main id="main" class="wrap resume">
    <header class="r-head">
      <div>
        <h1>{person.name}</h1>
        <p class="role">{person.role}</p>
      </div>
      <p class="contact">
        {person.location}<br />
        <a href={`mailto:${person.email}`}>{person.email}</a><br />
        <a href="https://hect.dev">hect.dev</a> · <a href={person.links.github}>{host(person.links.github)}</a><br />
        <a href={person.links.linkedin}>linkedin.com/in/hector-acosta</a>
      </p>
    </header>

    <p class="summary">{person.summary} {person.years}.</p>

    <h2>Experience</h2>
    {experience.map((job) => (
      <div class="entry">
        <div class="entry-head"><strong>{job.org}</strong><span>{job.period}</span></div>
        <p class="sub">{job.role}</p>
        <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    ))}

    <h2>Research</h2>
    <ul class="flat">
      {research.map((r) => <li><strong>{r.title}</strong> ({r.kind}). {r.text} <a href={r.url}>{r.linkLabel}</a></li>)}
    </ul>

    <h2>Selected projects</h2>
    <ul class="flat">
      {projects.slice(0, 3).map((p) => <li><strong>{p.name}</strong>. {p.text} <a href={p.repo}>{host(p.repo)}</a></li>)}
    </ul>

    <h2>Skills</h2>
    <ul class="flat">
      {skills.map((g) => <li><strong>{g.group}:</strong> {g.items.join(', ')}</li>)}
    </ul>

    <h2>Education</h2>
    {education.map((e) => (
      <div class="entry-head"><span><strong>{e.school}</strong>, {e.degree}</span><span>{e.place} · {e.years}</span></div>
    ))}

    <p class="screen-only dl"><a class="btn primary" href="/resume.pdf">Download PDF</a></p>
  </main>
</Base>

<style>
  .resume { max-width: 820px; padding-top: 24px; padding-bottom: 72px; font-size: 15px; }
  .r-head { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; align-items: flex-end; padding-bottom: 16px; border-bottom: 1px solid var(--hairline); }
  .r-head h1 { font-size: clamp(28px, 5vw, 36px); }
  .role { color: var(--accent); font-weight: 500; margin-top: 4px; }
  .contact { font-size: 13px; line-height: 1.55; text-align: right; color: var(--ink-subtle); }
  .summary { margin: 16px 0 8px; }
  h2 { font-size: 13px; font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-subtle); margin: 24px 0 10px; font-weight: 500; }
  .entry { margin-bottom: 12px; }
  .entry-head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .entry-head span:last-child { color: var(--ink-subtle); font-size: 14px; }
  strong { color: var(--ink); font-weight: 600; }
  .sub { color: var(--ink-subtle); font-size: 14px; }
  ul { margin: 6px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 3px; }
  .flat { padding-left: 18px; }
  .dl { margin-top: 32px; }
  @media (max-width: 600px) { .contact { text-align: left; } }

  @media print {
    :global(:root) {
      --canvas: #fff; --surface: #fff; --ink: #000; --ink-muted: #1d1f23; --ink-subtle: #4b5058;
      --hairline: #d6d8dc; --accent: #8a5a00;
    }
    :global(body) { font-size: 9.5pt; line-height: 1.38; }
    .screen-only { display: none !important; }
    .resume { padding: 0; max-width: none; font-size: 9.5pt; }
    ul { gap: 1px; margin-top: 3px; }
    .entry { margin-bottom: 7px; }
    .summary { margin: 10px 0 4px; }
    a { text-decoration: underline; text-decoration-color: #c9ccd1; }
    a { color: inherit; }
    .entry, li { break-inside: avoid; }
    h2 { margin: 10px 0 4px; break-after: avoid; }
    .sub, .entry-head span:last-child { font-size: 9.5pt; }
    .contact { font-size: 9pt; line-height: 1.4; }
    .r-head h1 { font-size: 24pt; }
  }
  @page { size: Letter; margin: 0.4in 0.55in; }
</style>
