---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { writing } from '../../data/profile';

export function getStaticPaths() {
  return writing
    .filter((w) => w.url.includes('gait.aicu.life'))
    .map((w) => ({ params: { slug: w.url.split('/').pop() }, props: { w } }));
}

const { w } = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/writing/*.{png,jpg,jpeg}', { eager: true });
const src = assets[`../../assets/${w.image}`].default;
const og = await getImage({ src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const date = new Date(w.date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${w.title} · Hector Acosta`} description={w.text} image={og.src} imageAlt={w.title} ogType="article" publishedTime={`${w.date}T00:00:00Z`}>
  <Header />
  <main id="main" class="wrap post">
    <p class="eyebrow">Writing · {date}</p>
    <h1>{w.title}</h1>
    <p class="lede">{w.text}</p>
    <a href={w.url} class="cover"><Image src={src} alt="" widths={[400, 800, 1200]} sizes="(max-width: 760px) 92vw, 720px" /></a>
    <p class="by muted">Written by Hector Andres Acosta Pozo for AICU's Step Doctor, published on gait.aicu.life.</p>
    <div class="cta">
      <a class="btn primary" href={w.url}>Read the article →</a>
      <a class="btn" href="/#writing">More writing</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .post { max-width: 760px; padding-top: clamp(32px, 6vw, 72px); padding-bottom: clamp(48px, 8vw, 96px); display: flex; flex-direction: column; gap: 16px; }
  .post h1 { font-size: clamp(28px, 4.4vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  .lede { font-size: clamp(17px, 2vw, 19px); color: var(--ink-muted); margin: 0; }
  .cover { display: block; margin-top: 8px; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--hairline); }
  .cover :global(img) { width: 100%; height: auto; display: block; }
  .by { font-size: 14px; margin: 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
</style>
