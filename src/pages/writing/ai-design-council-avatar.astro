---
// Native post. While its entry in src/data/profile.ts has `draft: true` it is noindex and hidden
// from the homepage; the sitemap filter in astro.config.mjs also excludes it until publish.
// Body text lives in src/data/posts/ai-design-council-avatar/*.md (generated by
// drafts/avatar-council/tools/merge-draft.py); visuals are placed between chunks. Every caption
// and alt text comes from figures.json in the same folder.
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import meta from '../../data/posts/ai-design-council-avatar/meta.json';
import figs from '../../data/posts/ai-design-council-avatar/figures.json';
import { writing } from '../../data/profile';

import v1 from '../../assets/writing/avatar-council/v1-prototype.png';
import r6 from '../../assets/writing/avatar-council/r6-hero.png';
import ogSrc from '../../assets/writing/avatar-council/og.jpg';
import jawR3 from '../../assets/writing/avatar-council/jaw-r3.png';
import jawR3g from '../../assets/writing/avatar-council/jaw-r3-grey.png';
import jawR6 from '../../assets/writing/avatar-council/jaw-r6.png';
import jawR6g from '../../assets/writing/avatar-council/jaw-r6-grey.png';
import overlay from '../../assets/writing/avatar-council/overlay.png';
import jawR6close from '../../assets/writing/avatar-council/jaw-r6-closeup.png';
import jawR6at120 from '../../assets/writing/avatar-council/jaw-r6-120.png';
import parityWeb from '../../assets/writing/avatar-council/parity-webview.png';
import parityNative from '../../assets/writing/avatar-council/parity-native.png';
import parityDiff from '../../assets/writing/avatar-council/parity-diff16.png';
import { Content as Tldr } from '../../data/posts/ai-design-council-avatar/tldr.md';

const chunks = Object.entries(
  import.meta.glob<{ Content: any; frontmatter: { after?: string[] } }>('../../data/posts/ai-design-council-avatar/[0-9]*.md', { eager: true }),
).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m);

// V5: the round 6 states page, one tile per state, labeled in HTML with the app's public names.
const stateImgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/writing/avatar-council/state-*.png', { eager: true });
const states = figs.V5.images.map((i) => ({ label: i.label, alt: i.alt, img: stateImgs[`../../assets/writing/avatar-council/${i.file}`].default }));

const roundImgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/writing/avatar-council/round-*.png', { eager: true });
const scores = [
  [4, 4.5, 3.5], [5, 6.5, 5], [6, 7, 6], [7, 7.5, 7], [7, 7.5, 7], [7, 7.5, 7.5],
];
const rounds = scores.map((s, i) => ({
  n: i + 1, s, img: roundImgs[`../../assets/writing/avatar-council/round-${i + 1}.png`].default,
}));
const roundAlt = figs.V2.images.map((i) => i.alt);

// V3 score chart geometry (y axis 0 to 10).
const series = [
  { key: 'Style', i: 0, cls: 's1', shape: 'circle', dx: -5 },
  { key: 'UX', i: 1, cls: 's2', shape: 'square', dx: 0 },
  { key: 'Concept', i: 2, cls: 's3', shape: 'diamond', dx: 5 },
];
const W = 640, H = 320, L = 44, R = 92, T = 16, B = 40;
const x = (r: number) => L + ((r - 1) * (W - L - R)) / 5;
const y = (v: number) => T + ((10 - v) * (H - T - B)) / 10;
const fbX = (x(3) + x(4)) / 2;
const marker = (shape: string, cx: number, cy: number) =>
  shape === 'circle' ? `M${cx - 4.5},${cy}a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0`
  : shape === 'square' ? `M${cx - 4},${cy - 4}h8v8h-8z`
  : `M${cx},${cy - 5.5}l5.5,5.5l-5.5,5.5l-5.5,-5.5z`;
// End labels: UX and Concept both end at 7.5, so they share one label.
const endLabels = [
  { y: y(7.5) - 1, parts: [['UX', 's2'], [', ', ''], ['Concept', 's3'], [' 7.5', '']] },
  { y: y(7) + 13, parts: [['Style', 's1'], [' 7', '']] },
];

const og = await getImage({ src: ogSrc, width: 1200, height: 630, format: 'jpg' });
const entry = writing.find((w) => w.url.endsWith('/writing/ai-design-council-avatar'))!;
const draft = !!entry.draft;
const date = new Date(entry.date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const [h1, h2] = figs.V1.images, [p1, p2, p3] = figs.V8.images, [j3, j6, j3g, j6g] = figs.V6.images, [jc, j120] = figs.V6b.images;
const repo = 'https://github.com/hectorandac/laura-voice';
---
<Base title={meta.ogTitle || `${meta.title} · Hector Acosta`} description={meta.description} image={og.src} imageAlt="Laura's first prototype avatar next to the round 6 face" ogType="article" publishedTime={`${entry.date}T00:00:00Z`} noindex={draft}>
  <Header />
  <main id="main" class="wrap article">
    <header class="head">
      <p class="eyebrow">Writing{draft && ' · Draft'}</p>
      <h1>{meta.title}</h1>
      {meta.dek && <p class="dek">{meta.dek}</p>}
      <p class="by muted">Hector Andres Acosta Pozo · <time datetime={entry.date}>{date}</time> · {Math.max(1, Math.round(meta.prose_words / 230))} min read</p>
    </header>

    {chunks.map(({ Content, frontmatter }) => (
      <>
        <div class="prose"><Content /></div>
        {(frontmatter.after ?? []).map((v) => (
          v === 'V1' ? (<>
            <figure class="wide hero">
              <div class="pair">
                <div><Image src={v1} alt={h1.alt} widths={[400, 700]} sizes="(max-width: 760px) 46vw, 440px" /><span class="tag">{h1.tag}</span></div>
                <div><Image src={r6} alt={h2.alt} widths={[400, 700]} sizes="(max-width: 760px) 46vw, 440px" /><span class="tag">{h2.tag}</span></div>
              </div>
              <figcaption>{figs.V1.caption}</figcaption>
            </figure>
            <aside class="tldr" aria-label="TL;DR"><p class="tl-h">In short</p><Tldr /></aside>
          </>) : v === 'V2' ? (
            <figure class="wide">
              <ol class="strip">
                {rounds.map((r) => (
                  <li>
                    <Image src={r.img} alt={roundAlt[r.n - 1]} widths={[200, 400]} sizes="(max-width: 640px) 30vw, 150px" />
                    <span class="r">Round {r.n}</span>
                    <span class="sc">{r.s.join(' · ')}</span>
                  </li>
                ))}
              </ol>
              <figcaption>{figs.V2.caption}</figcaption>
            </figure>
          ) : v === 'V3' ? (
            <figure class="chart">
              <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-t chart-d">
                <title id="chart-t">Council scores per round</title>
                <desc id="chart-d">On a 0 to 10 scale, style, UX and concept scores rose from 4, 4.5 and 3.5 in round 1 to 7, 7.5 and 7 in round 4, stayed flat in round 5, and concept reached 7.5 in round 6. My feedback came after round 3. Round 4 is also when the designer became three lanes and the render workbench was rebuilt.</desc>
                {[0, 2, 4, 6, 8, 10].map((v) => (
                  <g class="grid"><line x1={L} x2={W - R + 10} y1={y(v)} y2={y(v)} /><text x={L - 10} y={y(v) + 4} text-anchor="end">{v}</text></g>
                ))}
                {[1, 2, 3, 4, 5, 6].map((r) => <text class="axis" x={x(r)} y={H - 14} text-anchor="middle">R{r}</text>)}
                <g class="note">
                  <line x1={fbX} x2={fbX} y1={T - 4} y2={H - B + 4} />
                  <text x={fbX - 7} y={T + 10} text-anchor="end"><tspan x={fbX - 7}>my feedback</tspan><tspan x={fbX - 7} dy="1.25em">(after R3)</tspan></text>
                </g>
                <g class="note2">
                  <line x1={x(4)} x2={x(4)} y1={T - 4} y2={H - B + 4} />
                  <text x={x(4) + 7} y={T + 10}><tspan x={x(4) + 7}>3 design lanes +</tspan><tspan x={x(4) + 7} dy="1.25em">workbench rebuilt</tspan></text>
                </g>
                {series.map((s) => (
                  <g class={`series ${s.cls}`}>
                    <polyline points={scores.map((sc, r) => `${x(r + 1) + s.dx},${y(sc[s.i])}`).join(' ')} />
                    {scores.map((sc, r) => (
                      <path d={marker(s.shape, x(r + 1) + s.dx, y(sc[s.i]))}><title>{`${s.key}, round ${r + 1}: ${sc[s.i]}`}</title></path>
                    ))}
                  </g>
                ))}
                {endLabels.map((l) => (
                  <text class="lbl" x={x(6) + 15} y={l.y}>{l.parts.map(([t, c]) => <tspan class={c}>{t}</tspan>)}</text>
                ))}
              </svg>
              <ul class="legend" aria-hidden="true">
                {series.map((s) => <li class={s.cls}><svg viewBox="0 0 14 14" width="14" height="14"><path d={marker(s.shape, 7, 7)} /></svg>{s.key}</li>)}
              </ul>
              <figcaption>{figs.V3.caption}</figcaption>
              <details>
                <summary>Scores as a table</summary>
                <table>
                  <thead><tr><th>Round</th><th>Style</th><th>UX</th><th>Concept</th></tr></thead>
                  <tbody>{scores.map((s, i) => <tr><td>{i + 1}</td><td>{s[0]}</td><td>{s[1]}</td><td>{s[2]}</td></tr>)}</tbody>
                </table>
              </details>
            </figure>
          ) : v === 'V4' ? (
            <figure class="loop" aria-label="Diagram of the council loop">
              <div class="flow">
                <div class="node">Three independent proposals</div>
                <span class="arr" aria-hidden="true"></span>
                <div class="node">One brief, conflicts settled</div>
                <span class="arr" aria-hidden="true"></span>
                <div class="cycle">
                  <p class="cyc-h">Each round <span>× 6</span></p>
                  <ol>
                    <li>Implement in the app's three.js code</li>
                    <li>Render a fixed sheet: angles, states, 120&nbsp;px, grayscale</li>
                    <li>Three scored critiques: style, UX, concept</li>
                    <li>One prioritized fix list</li>
                  </ol>
                  <p class="back" aria-hidden="true">↺ next round</p>
                </div>
              </div>
              <div class="human">
                <div class="node me"><span class="who">Me, after round 3</span>The beard, and "bigger leaps"</div>
                <div class="node me"><span class="who">Me, after round 6</span>The ship call: round 6</div>
              </div>
              <figcaption>{figs.V4.caption}</figcaption>
            </figure>
          ) : v === 'V5' ? (
            <figure class="wide states">
              <ul>
                {states.map((st) => (
                  <li><Image src={st.img} alt={st.alt} widths={[200, 312]} sizes="(max-width: 640px) 22vw, 106px" /><span>{st.label}</span></li>
                ))}
              </ul>
              <figcaption>{figs.V5.caption}</figcaption>
            </figure>
          ) : v === 'V6' ? (
            <figure class="beard">
              <div class="grid2">
                <span class="h">Round 3 <span class="lab inline">gray band</span></span><span class="h">Round 6</span>
                <div class="ann">
                  <Image src={jawR3} alt={j3.alt} widths={[512]} sizes="(max-width: 760px) 46vw, 340px" />
                  <svg viewBox="0 0 512 320" aria-hidden="true"><rect x="64" y="146" width="384" height="56" rx="4" /></svg>
                </div>
                <Image src={jawR6} alt={j6.alt} widths={[512]} sizes="(max-width: 760px) 46vw, 340px" />
                <div class="ann">
                  <Image src={jawR3g} alt={j3g.alt} widths={[512]} sizes="(max-width: 760px) 46vw, 340px" />
                  <svg viewBox="0 0 512 320" aria-hidden="true"><rect x="64" y="146" width="384" height="56" rx="4" /></svg>
                </div>
                <Image src={jawR6g} alt={j6g.alt} widths={[512]} sizes="(max-width: 760px) 46vw, 340px" />
              </div>
              <figcaption>{figs.V6.caption}</figcaption>
            </figure>
          ) : v === 'V6b' ? (
            <figure class="beard jaw120">
              <div class="sizes">
                <div>
                  <span class="h">{jc.head}</span>
                  <div class="ann">
                    <Image src={jawR6close} alt={jc.alt} widths={[640]} sizes="(max-width: 760px) 92vw, 460px" />
                    <svg viewBox="0 0 640 576" aria-hidden="true"><ellipse cx="408" cy="524" rx="58" ry="30" /><ellipse cx="30" cy="380" rx="40" ry="62" /></svg>
                    <span class="lab" style="left:64%;top:82%">hair cube</span>
                    <span class="lab" style="left:15%;top:52%">gray lock tip</span>
                  </div>
                </div>
                <div>
                  <span class="h">{j120.head}</span>
                  <div class="actual">
                    <Image src={jawR6at120} format="png" width={120} height={98} alt={j120.alt} />
                  </div>
                </div>
              </div>
              <figcaption>{figs.V6b.caption}</figcaption>
            </figure>
          ) : v === 'V7' ? (
            <figure class="narrow">
              <Image src={overlay} alt={figs.V7.images[0].alt} widths={[390]} sizes="320px" />
              <figcaption>{figs.V7.caption}</figcaption>
            </figure>
          ) : v === 'V8' ? (
            <figure class="wide parity">
              <div class="pair three">
                <div><Image src={parityWeb} format="png" alt={p1.alt} widths={[512]} sizes="(max-width: 980px) 30vw, 296px" /><span class="tag">{p1.tag}</span></div>
                <div><Image src={parityNative} format="png" alt={p2.alt} widths={[512]} sizes="(max-width: 980px) 30vw, 296px" /><span class="tag">{p2.tag}</span></div>
                <div><Image src={parityDiff} format="png" alt={p3.alt} widths={[512]} sizes="(max-width: 980px) 30vw, 296px" /><span class="tag">{p3.tag}</span></div>
              </div>
              <figcaption>{figs.V8.caption}</figcaption>
            </figure>
          ) : null
        ))}
      </>
    ))}

    <footer class="end">
      <a class="btn primary" href={repo}>Laura on GitHub →</a>
      <a class="btn" href="/#writing">More writing</a>
    </footer>
  </main>
  <Footer />
</Base>

<style>
  .article { --measure: 700px; padding-top: clamp(32px, 6vw, 72px); padding-bottom: clamp(48px, 8vw, 96px); display: flex; flex-direction: column; align-items: center; }
  .article > * { width: 100%; max-width: var(--measure); }
  .article > .wide { max-width: 900px; }
  .head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }
  .head h1 { font-size: clamp(30px, 5vw, 46px); line-height: 1.1; letter-spacing: -0.03em; }
  .dek { font-size: clamp(18px, 2.2vw, 21px); line-height: 1.45; color: var(--ink-muted); }
  .by { font-size: 14px; }

  .prose { font-size: clamp(17px, 1.6vw, 18px); line-height: 1.7; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1em; }
  .prose :global(h2) { font-size: clamp(22px, 3vw, 28px); margin: 1.8em 0 0.6em; }
  .prose :global(h3) { font-size: 19px; margin: 1.4em 0 0.5em; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(.nw) { white-space: nowrap; }
  .prose :global(p code), .prose :global(li code) { white-space: nowrap; }
  .prose :global(details) { margin: 0 0 1.1em; padding: 10px 16px; background: var(--surface); border: 1px solid var(--hairline); border-radius: 10px; font-size: 15px; line-height: 1.55; color: var(--ink-muted); }
  .prose :global(details[open]) { padding-bottom: 4px; }
  .prose :global(summary) { cursor: pointer; color: var(--ink); font-weight: 500; }
  .prose :global(details > :not(summary):first-of-type) { margin-top: 10px; }
  .prose :global(details p), .prose :global(details ul) { margin: 0 0 0.8em; }
  .prose :global(blockquote) { margin: 1.4em 0; padding: 4px 0 4px 20px; border-left: 3px solid var(--accent); color: var(--ink); font-size: 1.08em; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.88em; background: var(--surface-2); padding: 1px 5px; border-radius: 4px; }
  .prose :global(pre) { background: var(--surface); border: 1px solid var(--hairline); border-radius: 8px; padding: 14px 16px; overflow-x: auto; font-size: 14px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(table) { border-collapse: collapse; margin: 0 0 1.3em; font-size: 15px; width: 100%; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 6px 12px 6px 0; border-bottom: 1px solid var(--hairline); }
  .prose :global(th) { color: var(--ink); font-weight: 600; }
  .prose :global(td:last-child) { font-family: var(--mono); font-size: 14px; white-space: nowrap; }
  .prose :global(.draft-note) { font: 13px/1.5 var(--mono); color: var(--accent); border: 1px dashed var(--accent); border-radius: 8px; padding: 10px 12px; margin: 0 0 1.1em; }
  .prose:empty { display: none; }

  figure { margin: 12px 0 36px; display: flex; flex-direction: column; gap: 10px; }
  figure :global(img) { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--hairline); background: #0d0c12; }
  figcaption { font-size: 14px; line-height: 1.5; color: var(--ink-subtle); max-width: var(--measure); }

  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pair.three { grid-template-columns: repeat(3, 1fr); }
  .pair > div { position: relative; }
  .tag { position: absolute; left: 10px; bottom: 10px; font: 500 12px/1 var(--mono); color: #f7f8f8; background: rgba(8, 9, 10, 0.72); padding: 6px 8px; border-radius: 6px; }

  .strip { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
  .strip li { display: flex; flex-direction: column; gap: 4px; }
  .strip .r { font: 500 13px/1.2 var(--sans); color: var(--ink); }
  .strip .sc { font: 12px/1.2 var(--mono); color: var(--ink-subtle); }
  @media (max-width: 640px) { .strip { grid-template-columns: repeat(3, 1fr); row-gap: 14px; } }

  .chart svg { width: 100%; height: auto; overflow: visible; }
  .chart .grid line { stroke: var(--hairline); stroke-width: 1; }
  .chart text { font: 12px var(--sans); fill: var(--ink-subtle); }
  .chart .note line { stroke: var(--accent); stroke-dasharray: 4 4; stroke-width: 1.5; }
  .chart .note text { fill: var(--ink-muted); }
  .chart .series polyline { fill: none; stroke-width: 2; stroke-linejoin: round; }
  .chart .series path { stroke: var(--canvas); stroke-width: 2; paint-order: stroke; }
  .chart .lbl { font: 600 13px var(--sans); fill: var(--ink); }
  .chart .lbl tspan.s1, .chart .lbl tspan.s2, .chart .lbl tspan.s3 { fill: var(--c); }
  .s1 { --c: #257de0; } .s2 { --c: #f47230; } .s3 { --c: #00b894; }
  @media (prefers-color-scheme: dark) { .s1 { --c: #338ced; } .s2 { --c: #e76624; } .s3 { --c: #00a888; } }
  .chart .series polyline { stroke: var(--c); }
  .chart .series path { fill: var(--c); }
  @media (max-width: 640px) {
    .chart text { font-size: 21px; }
    .chart .lbl { display: none; }
    .chart .series polyline { stroke-width: 3; }
  }
  .chart .legend { list-style: none; display: flex; gap: 18px; padding: 0; margin: 0; font-size: 13px; color: var(--ink-muted); }
  .chart .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .chart .legend path { fill: var(--c); }
  .chart details { font-size: 14px; color: var(--ink-subtle); }
  .chart summary { cursor: pointer; }
  .chart table { border-collapse: collapse; margin-top: 8px; font: 13px var(--mono); }
  .chart th, .chart td { border-bottom: 1px solid var(--hairline); padding: 4px 14px 4px 0; text-align: left; }

  .loop .flow { display: grid; grid-template-columns: 1fr auto 1fr auto 2.2fr; align-items: center; gap: 10px; }
  .loop .node, .loop .cycle { background: var(--surface); border: 1px solid var(--hairline-strong); border-radius: 10px; padding: 12px 14px; font-size: 14px; line-height: 1.4; color: var(--ink); }
  .loop .arr::before { content: '→'; color: var(--accent); font-size: 20px; }
  .loop .cycle { border-color: var(--accent); }
  .loop .cyc-h { font: 600 13px/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px; color: var(--ink-subtle); }
  .loop .cyc-h span { color: var(--accent); }
  .loop ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
  .loop .back { margin-top: 8px; font: 12px var(--mono); color: var(--accent); }
  .loop .human { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .loop .node.me { border: 1px solid var(--accent); display: flex; flex-direction: column; gap: 4px; }
  .loop .me .who { font: 600 13px/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.03em; color: var(--accent); }
  @media (max-width: 640px) {
    .loop .flow { grid-template-columns: 1fr; }
    .loop .arr { text-align: center; }
    .loop .arr::before { content: '↓'; }
    .loop .human { grid-template-columns: 1fr; }
  }

  .tldr { margin: 0 0 40px; padding: 18px 0 20px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); font-size: 16px; line-height: 1.55; }
  .tldr .tl-h { font: 500 11px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); margin: 0 0 14px; }
  .tldr :global(ul) { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .tldr :global(li) { position: relative; padding-left: 22px; color: var(--ink); }
  .tldr :global(li)::before { content: ''; position: absolute; left: 0; top: 0.78em; width: 10px; height: 1px; background: var(--ink-muted); }
  .prose :global(blockquote) { font-size: 1.25em; line-height: 1.4; font-weight: 500; }


  .chart .note2 line { stroke: var(--ink-subtle); stroke-width: 1.5; }
  .chart .note2 text { fill: var(--ink-muted); }

