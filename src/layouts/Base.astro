---
import '../styles/global.css';
import { person, education, experience } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  publishedTime?: string;
}

const {
  title = `${person.name}, ${person.role}`,
  description = `${person.shortName} is an ML engineer in ${person.location} working on computer vision and edge AI. ${person.years}. Lead of the AICU Gait Scanner, MSc Computer Science at Kyungpook National University.`,
  noindex = false,
  image,
  imageAlt,
  ogType = 'profile',
  publishedTime,
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image ?? '/og.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  alternateName: ['Hector Acosta', 'Hector A. Acosta', 'Héctor Acosta Pozo'],
  url: 'https://hect.dev',
  image: new URL('/hector-acosta.webp', Astro.site).href,
  jobTitle: 'Machine Learning Engineer',
  worksFor: { '@type': 'Organization', name: experience[0].org, url: experience[0].url },
  alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school, url: e.url })),
  address: { '@type': 'PostalAddress', addressLocality: 'Daegu', addressCountry: 'KR' },
  knowsAbout: ['Computer vision', 'Edge AI', 'Object detection', 'Pose estimation', 'MLOps', 'Kubernetes'],
  sameAs: Object.values(person.links),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#08090a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="hect.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? `${person.name}, ${person.role}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {publishedTime && <meta name="date" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://hect.dev" />}
    {ogType === 'profile' && <meta property="profile:first_name" content="Hector" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Acosta Pozo" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
